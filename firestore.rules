rules_version = '2';

/*  Daftar security rules.
 *  Each shop lives under shops/{uid}, where uid is that account's own id.
 *  These rules say: you may read and write your own shop, and nothing else.
 *  Paste into Firebase console -> Firestore Database -> Rules -> Publish.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
